# ---------- App ----------
APP_URL=http://localhost:3000
# 32+ random chars. Signs share links and hashes IPs. `openssl rand -base64 48`
APP_SECRET=
# Comma-separated emails allowed to open /usage
ADMIN_EMAILS=
SUPPORT_EMAIL=support@example.com
# Optional: id of a real report rendered on the landing page as the sample
SAMPLE_REPORT_ID=

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Postgres connection string. On Vercel use the Supavisor *transaction* pooler (port 6543).
DATABASE_URL=

# ---------- LLM (edit + redeploy to change provider; never editable from the app) ----------
# anthropic | openai | deepseek | ollama_cloud
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
# Price per 1M tokens in EUR, used for report.meta.costEur and /usage
LLM_PRICE_IN_EUR_PER_MTOK=0.09
LLM_PRICE_OUT_EUR_PER_MTOK=0.45
# Optional fallback provider, used only after the primary fails twice
LLM_FALLBACK=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_PRICE_IN_EUR_PER_MTOK=
LLM_FALLBACK_PRICE_OUT_EUR_PER_MTOK=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids for the one-time packs (EUR 3.90 x1 credit, EUR 9.90 x3 credits)
STRIPE_PRICE_1=
STRIPE_PRICE_3=
